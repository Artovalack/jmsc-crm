# Copy this file to .env.local and replace the placeholders.
# Supabase Dashboard -> Project Settings -> API (or Connect)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY

# Used for email links and callbacks in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never put a Supabase service-role/secret key in NEXT_PUBLIC_* or this app's browser bundle.
